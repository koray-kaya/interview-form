# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Supabase → project interview-form → Settings → API Keys.
SUPABASE_URL=
# Secret key (starts with sb_secret_). Server only — never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Any random string of 32+ characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
# Optional until M4 (Vercel Blob store for the daily export).
BLOB_READ_WRITE_TOKEN=
# Local development only (M3): AI Gateway key. Production uses OIDC, no key.
AI_GATEWAY_API_KEY=
# The AI probe's kill switch. Only "true" turns it on; anything else is off.
PROBE_ENABLED=
